# Secrets: never in an image. The app's settings come from Container Apps env vars and secrets.
**/.env
**/.env.*
!**/.env.example

.git
**/node_modules
**/.next
.claude/
pitch/
**/.venv
**/__pycache__
.audit/
brain/evals/out/

# Local data stays out, except the files the brain image copies on purpose.
brain/data/*
!brain/data/snapshot/
!brain/data/demo-snapshot.db
!brain/data/concept_vectors.npy
