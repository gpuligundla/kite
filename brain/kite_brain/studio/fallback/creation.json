        "lines": [
          {
            "speaker": "Narrator",
            "voice": "narrator",
            "text": "So blue light is bouncing toward your eyes from every part of the sky."
          },
          {
            "speaker": "Robot Buddy",
            "voice": "robot_buddy",
            "text": "That is why the sky is blue. Pretty cool, right?"
          }
        ],
